  {%- elsif v contains 'red' or v contains 'cardinal' -%}{%- assign hex = '#B3342C' -%}
  {%- elsif v contains 'orange' -%}{%- assign hex = '#D97A2B' -%}
  {%- elsif v contains 'mustard' or v contains 'gold' or v contains 'yellow' or v contains 'maize' -%}{%- assign hex = '#D8A620' -%}
  {%- elsif v contains 'brown' or v contains 'chocolate' or v contains 'espresso' or v contains 'coffee' -%}{%- assign hex = '#5A4232' -%}
