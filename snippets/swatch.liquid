  {%- elsif v contains 'lilac' or v contains 'lavender' -%}{%- assign hex = '#C0AED2' -%}
  {%- elsif v contains 'olive' or v contains 'military' or v contains 'army' -%}{%- assign hex = '#6A7B3D' -%}
