<header class="site-head">
  <div class="site-head__in">
    <a href="{{ routes.root_url }}" class="brand">
      {% if section.settings.logo %}
        <img src="{{ section.settings.logo | image_url: width: 200 }}" alt="{{ shop.name }}" width="84">
      {% endif %}
      <span style="display:flex;flex-direction:column;gap:2px">
        <span class="brand__eth">{{ section.settings.amharic }}</span>
        <span class="brand__latin">{{ shop.name }}</span>
      </span>
    </a>
    <nav class="site-nav">
      {% for link in linklists[section.settings.menu].links %}
        <a href="{{ link.url }}">{{ link.title }}</a>
      {% endfor %}
    </nav>
    <a href="{{ routes.cart_url }}" class="cart-link">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M6 2l1.5 4h13L19 15H8L6 2H3"/><circle cx="9" cy="20" r="1.6"/><circle cx="18" cy="20" r="1.6"/></svg>
      Cart ({{ cart.item_count }})
    </a>
  </div>
</header>
{% schema %}
{
  "name": "Header",
  "settings": [
    { "type": "image_picker", "id": "logo", "label": "Sash mark" },
    { "type": "text", "id": "amharic", "label": "Amharic wordmark", "default": "መቀነት" },
    { "type": "link_list", "id": "menu", "label": "Menu", "default": "main-menu" }
  ]
}
{% endschema %}
