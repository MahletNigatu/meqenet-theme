<section class="sec">
  {% if section.settings.heading != blank %}<h2>{{ section.settings.heading }}</h2>{% endif %}
  {% if section.settings.sub != blank %}<p class="sec__sub">{{ section.settings.sub }}</p>{% endif %}
  <div class="coll-grid">
    {% for block in section.blocks %}
      {% assign coll = collections[block.settings.collection] %}
      {% assign style = block.settings.style %}
      {% assign href = coll.url | default: '#' %}
      <a href="{{ href }}" class="coll{% if style == 'dark' %} coll--dark{% endif %}{% if style == 'soon' %} coll--soon{% endif %}" {{ block.shopify_attributes }}>
        {% if style == 'soon' %}<span class="flag" style="background:{{ block.settings.accent }}">Coming Soon</span>{% endif %}
        <div class="coll__img"{% if style == 'light' %} style="background:{{ block.settings.tint }}"{% endif %}>
          {% if block.settings.image %}
            <img src="{{ block.settings.image | image_url: width: 900 }}" alt="{{ block.settings.title | escape }}" loading="lazy">
          {% elsif coll.featured_image %}
            <img src="{{ coll.featured_image | image_url: width: 900 }}" alt="{{ coll.title | escape }}" loading="lazy">
          {% elsif block.settings.fallback != blank %}
            <img src="{{ block.settings.fallback | asset_url }}" alt="{{ block.settings.title | escape }}" loading="lazy">
          {% endif %}
        </div>
        <div class="coll__body">
          <div class="coll__top">
            <h3>{{ block.settings.title | default: coll.title }}</h3>
            {% unless style == 'soon' %}
              <span class="pill" style="color:{% if style == 'dark' %}var(--cream);border-color:rgba(248,244,244,0.6){% else %}{{ block.settings.accent }}{% endif %}">Shop Now</span>
            {% endunless %}
          </div>
          <p>{{ block.settings.blurb }}</p>
        </div>
      </a>
    {% endfor %}
  </div>
</section>
{% schema %}
{
  "name": "Collection tiles",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Shop by Collection" },
    { "type": "text", "id": "sub", "label": "Subhead", "default": "Four lines, four visual worlds, one brand." }
  ],
  "blocks": [{
    "type": "tile", "name": "Tile",
    "settings": [
      { "type": "collection", "id": "collection", "label": "Shopify collection" },
      { "type": "text", "id": "title", "label": "Title override" },
      { "type": "textarea", "id": "blurb", "label": "Blurb" },
      { "type": "image_picker", "id": "image", "label": "Tile art" },
      { "type": "text", "id": "fallback", "label": "Bundled asset filename (fallback)" },
      { "type": "color", "id": "accent", "label": "Accent", "default": "#C4695A" },
      { "type": "color", "id": "tint", "label": "Image ground", "default": "#FBEDE8" },
      { "type": "select", "id": "style", "label": "Treatment", "default": "light",
        "options": [
          { "value": "light", "label": "Light (cream)" },
          { "value": "dark", "label": "Dark (Society)" },
          { "value": "soon", "label": "Coming soon" }
        ] }
    ]
  }],
  "presets": [{ "name": "Collection tiles" }]
}
{% endschema %}
