<main class="sec" style="padding-top:52px">
  <p class="kicker">Contact &amp; help</p>
  <h1 class="coll__h1">{{ section.settings.heading }}</h1>
  <p class="coll__lede">This now lives on one page with everything else.</p>
  <p style="margin-top:26px"><a href="/pages/contact#{{ section.settings.anchor }}" class="btn">Read it there
    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M5 12h14"/><path d="M13 6l6 6-6 6"/></svg>
  </a></p>
  <meta http-equiv="refresh" content="0;url=/pages/contact#{{ section.settings.anchor }}">
</main>
{% schema %}
{
  "name": "Moved",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "text", "id": "anchor", "label": "Anchor on the contact page" }
  ]
}
{% endschema %}
