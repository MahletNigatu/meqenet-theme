<section class="sec" style="padding-top:52px">
  <p class="kicker">{{ section.settings.kicker }}</p>
  <h1 style="font-size:clamp(32px,5.5vw,44px);margin:0 0 18px">{{ section.settings.heading }}</h1>
  <p style="max-width:60ch;font-size:15.5px;line-height:1.75;color:var(--ink-soft)">{{ section.settings.body }}</p>
  <p style="margin-top:26px"><a href="{{ routes.root_url }}" class="link-underline">Back home</a></p>
</section>
{% schema %}
{
  "name": "Placeholder",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "MEQENET" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Coming soon" },
    { "type": "textarea", "id": "body", "label": "Body", "default": "This page is still being built." }
  ]
}
{% endschema %}
