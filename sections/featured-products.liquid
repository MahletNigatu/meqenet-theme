<section class="band">
  <div class="band__in">
    <div class="band__head">
      <div>
        {% if section.settings.heading != blank %}<h2>{{ section.settings.heading }}</h2>{% endif %}
        {% if section.settings.sub != blank %}<p style="margin:0;color:rgba(17,17,17,0.6);font-size:14.5px">{{ section.settings.sub }}</p>{% endif %}
      </div>
      {% if section.settings.link_label != blank %}
        <a href="{{ section.settings.link_url }}" style="font-family:var(--head);font-size:14px;letter-spacing:0.08em;text-transform:uppercase;border-bottom:1px solid rgba(216,166,32,0.6);padding-bottom:2px">{{ section.settings.link_label }}</a>
      {% endif %}
    </div>
    <div class="prod-grid">
      {% assign src = collections[section.settings.collection].products %}
      {% if src.size > 0 %}
        {% for product in src limit: section.settings.count %}
          <a href="{{ product.url }}" class="prod">
            <div class="prod__mat tilat-sky">
              <div class="prod__img">
                {% if product.featured_image %}
                  <img src="{{ product.featured_image | image_url: width: 700 }}" alt="{{ product.featured_image.alt | default: product.title | escape }}" loading="lazy">
                {% endif %}
              </div>
            </div>
            <div class="prod__body">
              {% if product.collections.first %}
                <span class="tag" style="color:{{ section.settings.tag_color }}">{{ product.collections.first.title }}</span>
              {% endif %}
              <h4>{{ product.title }}</h4>
              <p class="prod__meta">{{ product.price | money }}{% if product.type != blank %} &middot; {{ product.type }}{% endif %}</p>
            </div>
          </a>
        {% endfor %}
      {% else %}
        <p class="prod__empty">No products yet. Pick a collection for this section in the theme editor, or add products in Printful &mdash; they appear here automatically.</p>
      {% endif %}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Featured products",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Featured" },
    { "type": "text", "id": "sub", "label": "Subhead", "default": "From the live collections." },
    { "type": "collection", "id": "collection", "label": "Source collection" },
    { "type": "range", "id": "count", "label": "How many", "min": 2, "max": 12, "step": 1, "default": 4 },
    { "type": "text", "id": "link_label", "label": "Corner link label", "default": "Shop all" },
    { "type": "url", "id": "link_url", "label": "Corner link" },
    { "type": "color", "id": "tag_color", "label": "Tag color", "default": "#2E6E9E" }
  ],
  "presets": [{ "name": "Featured products" }]
}
{% endschema %}
