<footer class="site-foot">
  <div class="site-foot__in">
    <div>
      <img src="{{ 'sash-knot.png' | asset_url }}" alt="{{ shop.name }}" width="96" style="margin-bottom:16px;opacity:.9">
      <span class="brand__eth" style="display:block;margin-bottom:8px">{{ section.settings.amharic }}</span>
      <p style="margin:0;font-size:14px;line-height:1.65;color:var(--ink-mute);max-width:34ch">{{ section.settings.blurb }}</p>
    </div>

    <div>
      <h4>Shop</h4>
      <ul>
        <li><a href="{{ routes.all_products_collection_url }}">Shop All</a></li>
        {% for c in collections %}
          {%- unless c.handle == 'frontpage' or c.products_count == 0 -%}
            <li><a href="{{ c.url }}">{{ c.title }}</a></li>
          {%- endunless -%}
        {% endfor %}
        <li><a href="/pages/addis-abeba">Addis Abeba &mdash; soon</a></li>
      </ul>
    </div>

    <div>
      <h4>The brand</h4>
      <ul>
        <li><a href="/pages/our-story">Our Story</a></li>
        <li><a href="/pages/how-its-made">How it's made</a></li>
        <li><a href="/pages/size-guide">Size guide</a></li>
        <li><a href="/pages/contact">Contact</a></li>
      </ul>
    </div>

    <div>
      <h4>Help</h4>
      <ul>
        <li><a href="/pages/shipping">Shipping</a></li>
        <li><a href="/pages/returns">Returns &amp; exchanges</a></li>
        <li><a href="/policies/refund-policy">Refund policy</a></li>
        <li><a href="/policies/privacy-policy">Privacy</a></li>
        <li><a href="/policies/terms-of-service">Terms</a></li>
      </ul>
    </div>

    <div>
      <h4>{{ section.settings.news_title }}</h4>
      <p style="margin:0 0 14px;font-size:14px;line-height:1.6;color:var(--ink-soft);max-width:34ch">{{ section.settings.news_body }}</p>
      {% form 'customer' %}
        <input type="hidden" name="contact[tags]" value="newsletter">
        <div class="news">
          <input type="email" name="contact[email]" placeholder="you@email.com" required aria-label="Email">
          <button type="submit">Join</button>
        </div>
        {% if form.posted_successfully? %}<p style="margin:10px 0 0;font-size:13px;color:var(--olive)">Thank you &mdash; you are on the list.</p>{% endif %}
      {% endform %}
    </div>
  </div>

  <div class="site-foot__bar">
    <span>&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}. All rights reserved.</span>
    <span class="foot__tag">{{ section.settings.tagline }}</span>
  </div>
</footer>
{% schema %}
{
  "name": "Footer",
  "settings": [
    { "type": "text", "id": "amharic", "label": "Amharic wordmark", "default": "መቀነት" },
    { "type": "textarea", "id": "blurb", "label": "Blurb", "default": "A women's empowerment lifestyle brand built on the Ethiopian sash." },
    { "type": "text", "id": "news_title", "label": "Newsletter heading", "default": "The list" },
    { "type": "textarea", "id": "news_body", "label": "Newsletter body", "default": "New drops and collection news. Nothing else." },
    { "type": "text", "id": "tagline", "label": "Bar tagline", "default": "Tie Yourself Together." }
  ]
}
{% endschema %}
