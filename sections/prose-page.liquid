<main class="sec" style="padding-top:52px">
  <p class="kicker">{{ section.settings.kicker }}</p>
  <h1 class="coll__h1">{{ section.settings.heading | default: page.title }}</h1>
  <div class="prose">
    {% if page.content != blank %}
      {{ page.content }}
    {% else %}
      {{ section.settings.body }}
    {% endif %}
  </div>
</main>
{% schema %}
{
  "name": "Prose page",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "MEQENET" },
    { "type": "text", "id": "heading", "label": "Heading override" },
    { "type": "richtext", "id": "body", "label": "Body (used when the page itself is empty)" }
  ]
}
{% endschema %}
