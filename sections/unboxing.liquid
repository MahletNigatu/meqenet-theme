<section class="split">
  <div class="mat">
    <div class="mat__img">
      {% if section.settings.image %}
        <img src="{{ section.settings.image | image_url: width: 1100 }}" alt="{{ section.settings.image.alt | escape }}" loading="lazy">
      {% endif %}
    </div>
  </div>
  <div>
    {% if section.settings.kicker != blank %}<p class="kicker">{{ section.settings.kicker }}</p>{% endif %}
    {% if section.settings.heading != blank %}<h2>{{ section.settings.heading }}</h2>{% endif %}
    {% if section.settings.body != blank %}<p>{{ section.settings.body }}</p>{% endif %}
    {% if section.settings.quote != blank %}
      <div class="notecard"><p>{{ section.settings.quote }}</p></div>
    {% endif %}
  </div>
</section>
{% schema %}
{
  "name": "Unboxing",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Packaging photo" },
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "The unboxing" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Every order arrives tied." },
    { "type": "textarea", "id": "body", "label": "Body" },
    { "type": "textarea", "id": "quote", "label": "Note card quote" }
  ],
  "presets": [{ "name": "Unboxing" }]
}
{% endschema %}
